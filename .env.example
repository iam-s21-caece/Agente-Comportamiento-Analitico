# --- Copiá este archivo a .env y completá los valores reales (NO commitear .env) ---

# LLM (DeepSeek)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1

# Keycloak / Admin REST API
KEYCLOAK_BASE_URL=https://localhost:8443
KEYCLOAK_REALM=poc
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
# Certificados self-signed del entorno de investigación: mantener en false.
TLS_VERIFY=false

# Docker
CONTAINER_NAME=keycloak

# Fallback H2 (solo si la Admin REST API no es viable)
H2_JDBC_URL=jdbc:h2:file:/opt/keycloak/data/h2/keycloakdb;AUTO_SERVER=TRUE
H2_USER=sa
H2_PASSWORD=password

# Detección del proceso JVM (substring buscado en el cmdline)
JVM_CMDLINE_MATCH=kc.config

# Baseline DoS (modo híbrido: lee archivo si existe, si no lo calcula al iniciar)
BASELINE_WARMUP_SECONDS=20
BASELINE_SAMPLE_INTERVAL_SECONDS=2

# Ventanas y bucle
EVENT_WINDOW_MINUTES=5
CONTINUOUS_INTERVAL_SECONDS=10
ALWAYS_ANALYZE=false
# Cooldown de alertas (seg): no re-alertar la misma anomalía dentro de esta ventana.
ALERT_COOLDOWN_SECONDS=300

# Dashboard embebido (el agente lo sirve; con network_mode host queda en el puerto del host)
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8081
# SEGURIDAD: 0.0.0.0 expone el panel a toda la red de la VPS (el "login" es
# cosmético, no protege). Para restringir: DASHBOARD_HOST=127.0.0.1 y accedé por
# túnel SSH (ssh -L 8081:127.0.0.1:8081 root@vps), o firewalleá el puerto 8081.
DASHBOARD_HOST=0.0.0.0

# ReAct
REACT_MAX_ITERATIONS=20

# Salida de alertas (directorio persistido; en contenedor se monta como volumen)
# Local: por defecto ./alerts. En contenedor el compose lo fija a /data/alerts.
# ALERTS_DIR=/data/alerts
# BASELINE_PATH=/data/baseline.json

# Trazabilidad (capa observacional del ciclo agéntico)
TRACE_ENABLED=true
# TRACES_DIR=/data/traces
TRACE_MAX_EVENT_BYTES=8192

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
